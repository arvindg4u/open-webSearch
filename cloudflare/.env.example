# Cloudflare Workers environment for the open-websearch edge MCP server.
#
# Set these as Worker Variables and Secrets (encrypt anything sensitive):
#   wrangler secret put MCP_AUTH_TOKEN
#   wrangler secret put JINA_API_KEY
#
# Local development reads this file via `wrangler dev --env-file .env`.

# Optional. A public SearXNG instance to aggregate many engines through one API.
# NOTE: a Worker cannot reach a local Docker instance on 127.0.0.1; host SearXNG
# publicly (VPS / Fly.io / Railway) and point this at its URL, or leave it unset.
SEARXNG_URL=
# Optional bearer token the Worker sends to the SearXNG endpoint, for when the
# instance sits behind an auth proxy (e.g. this repo's nginx vhost).
SEARXNG_API_KEY=

# Wikipedia language subdomain (default: en).
WIKIPEDIA_LANG=en

# Search-result cache TTL in seconds (0 disables caching). Requires the CACHE KV binding.
SEARCH_CACHE_TTL_SECONDS=300

# Optional shared secret. When set, requests to /mcp must send
# `Authorization: Bearer <token>` (or `?token=<token>`). When unset the endpoint
# is open — only run it open behind a trusted boundary.
MCP_AUTH_TOKEN=

# Optional Jina Reader fallback for JS-heavy / PDF / anti-bot pages (free tier).
JINA_READER_ENABLED=false
JINA_API_KEY=
JINA_READER_BASE_URL=

# Comma-separated allowlist of search engines. Empty = every available engine
# (duckduckgo,bing,wikipedia, plus searxng when SEARXNG_URL is set).
# Note: Bing's RSS feed is licensed for personal, non-commercial use; omit `bing`
# from this list if that does not fit your deployment.
ALLOWED_SEARCH_ENGINES=
# Engine used only as a fallback when a request names an unavailable engine.
DEFAULT_SEARCH_ENGINE=duckduckgo
