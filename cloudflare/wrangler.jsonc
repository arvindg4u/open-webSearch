{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-websearch",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  // KV backs the search-result cache (and is optional: unset the binding and
  // the server simply does not cache). Create it with:
  //   wrangler kv namespace create CACHE
  // and paste the returned id below (or set it via DEPLOY_* in CI).
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "9689385819db44978a0bb21592291479"
    }
  ],
  "vars": {
    "WIKIPEDIA_LANG": "en",
    "SEARCH_CACHE_TTL_SECONDS": "300"
  }
}
